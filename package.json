{
  "name": "planif",
  "private": true,
  "description": "Planification d'entraînement course à pied et calcul des allures (PWA statique, sans dépendance d'exécution).",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "check": "node scripts/check-syntax.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=Europe/Paris node --test tests/*.test.cjs",
    "test:tz": "node scripts/test-tz.cjs",
    "version:check": "node scripts/bump-version.cjs --check",
    "version:bump": "node scripts/bump-version.cjs",
    "audit": "npm run -s audit:planning && npm run -s audit:personal-load && npm run -s audit:block-load",
    "audit:planning": "TZ=Europe/Paris node scripts/audit-planning-baseline.cjs",
    "audit:personal-load": "TZ=Europe/Paris node scripts/audit-personal-load.cjs",
    "audit:block-load": "TZ=Europe/Paris node scripts/audit-block-load.cjs",
    "verify-live": "node scripts/verify-live.cjs",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
